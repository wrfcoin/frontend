{
  "source": "infra testnet/edge/public_onboarding.caddy (public_onboarding_api), GET matchers plus the S9 send routes from infra#1319 (head 07cc748d, not yet merged); infraCommit = infra main ac481c06 for the GET set; public_balance_read from wrfcoin/infra main 3a4f3658 (@public_balance_read, infra#67); public_proof_card from the wrfcoin/infra proof-card edge PR (@public_readonly_proof_card, backend#229); public_network_nodes from wrfcoin/infra#72 (@public_readonly_network_nodes); wolfram_reading_check from wrfcoin/infra#74 (@wolfram_reading_check, owner ruling 2026-11-01); public_readonly_competitions (backend#251) from wrfcoin/infra feat/edge-competitions-notify, pending merge; payout notification routes (@public_notifications_*, backend#389) from wrfcoin/infra#76; public_readonly_calibration_certificate from the wrfcoin/infra calibration-certificate edge PR (@public_readonly_calibration_certificate); passkey-signed payout notification routes (@public_notifications_passkey_*) from the wrfcoin/infra passkey-notify edge PR (infra#83); forecast check reads and hand-in from the wrfcoin/infra forecast-check edge PR (demo item 7); friend challenge board and wallet calls from the wrfcoin/infra demo-items 7/8/10 edge PR",
  "infraCommit": "ac481c06974e298ed17ddbbae0a3a745b6602850",
  "readonlyApi": "on",
  "note": "PUBLIC_READONLY_API=on is the Stage 1.5 edge state. `query: null` admits any query string; an array admits exactly those query strings (\"\" = none); `queryPattern` (optional) additionally admits any query matching that regex (the edge `{query}.matches(...)` expression, public_readonly_weather_leaderboard). `requiresBearer: true` marks a matcher that also requires an `Authorization: Bearer *` request header. Refresh this file whenever the edge allowlist changes.",
  "get": [
    { "name": "wallet_nonce", "path": "^/api/auth/nonce/0x[0-9A-Fa-f]{40}$", "query": null },
    { "name": "station_reward_progress", "path": "^/api/weather/stations/[A-Za-z0-9_-]{1,64}/reward-progress$", "query": null },
    { "name": "chain_status", "path": "^/api/blockchain/status$", "query": null },
    { "name": "chain_blocks", "path": "^/api/blockchain/blocks$", "query": null },
    { "name": "chain_transactions", "path": "^/api/blockchain/transactions$", "query": null },
    { "name": "chain_transaction_detail", "path": "^/api/blockchain/transactions/(0x)?[0-9A-Fa-f]{64}$", "query": null },
    { "name": "chain_validators", "path": "^/api/blockchain/validators$", "query": null },
    { "name": "chain_stats", "path": "^/api/blockchain/stats$", "query": null },
    { "name": "weather_coverage_zones", "path": "^/api/weather/coverage-zones$", "query": null },
    { "name": "public_readonly_stations", "path": "^/api/weather/stations$", "query": [""] },
    { "name": "public_readonly_station_detail", "path": "^/api/stations/[A-Za-z0-9_-]{1,64}/(observations|quality|submissions)$", "query": ["", "limit=1"] },
    { "name": "public_readonly_station_ownership", "path": "^/api/stations/st_[0-9a-f]{12}/ownership$", "query": [""] },
    { "name": "public_weather_leaderboard", "path": "^/api/weather/leaderboard$", "query": [], "queryPattern": "^metric=(earnings|submissions|quality_score|streak)&period=(7d|30d|all)&limit=([1-9]|[12][0-9]|30)$" },
    { "name": "public_build", "path": "^/api/build$", "query": null },
    { "name": "public_capabilities", "path": "^/api/capabilities$", "query": null },
    { "name": "station_mobile_status", "path": "^/api/weather/stations/mobile$", "query": [""] },
    { "name": "public_readonly_station_earnings", "path": "^/api/stations/[A-Za-z0-9_-]{1,64}/earnings$", "query": [""] },
    { "name": "public_earnings_leaderboard", "path": "^/api/earnings/leaderboard$", "query": [], "queryPattern": "^role=(contribution|attester|producer|node|forecast)&period=(all|7d|30d)&limit=([1-9]|[12][0-9]|30)$" },
    { "name": "public_operator_profile", "path": "^/api/operators/c_[0-9a-f]{24}/profile$", "query": [""] },
    { "name": "public_wallet_info", "path": "^/api/wallet/0x[0-9A-Fa-f]{40}$", "query": [""], "requiresBearer": true },
    { "name": "public_wallet_transactions", "path": "^/api/wallet/0x[0-9A-Fa-f]{40}/transactions$", "query": [], "queryPattern": "^limit=([1-9]|[1-4][0-9]|50)&offset=[0-9]{1,6}$", "requiresBearer": true },
    { "name": "public_wallet_send_nonce", "path": "^/api/wallet/0x[0-9a-f]{40}/nonce$", "query": [""], "requiresBearer": true },
    { "name": "public_governance_proposals", "path": "^/api/governance/proposals$", "query": [""], "queryPattern": "^limit=([1-9]|[1-9][0-9]|100)&offset=[0-9]{1,6}$" },
    { "name": "public_governance_proposal", "path": "^/api/governance/proposals/[A-Za-z0-9_-]{1,128}$", "query": [""] },
    { "name": "public_governance_treasury", "path": "^/api/governance/treasury$", "query": [""] },
    { "name": "public_weather_current", "path": "^/api/weather/current/-?[0-9]{1,2}\\.[0-9],-?[0-9]{1,3}\\.[0-9]$", "query": [""] },
    { "name": "public_balance_read", "path": "^/api/public/balance/0x[0-9a-fA-F]{40}$", "query": [""] },
    { "name": "public_proof_card", "path": "^/api/proofs/[0-9a-f]{64}$", "query": [""], "queryPattern": "^h=[1-9][0-9]{0,11}$" },
    { "name": "public_network_nodes", "path": "^/api/network/nodes$", "query": [""] },
    { "name": "public_readonly_calibration_certificate", "path": "^/api/calibration-certificates/station/st_[0-9a-f]{12}$", "query": [""] },
    { "name": "public_weather_forecast", "path": "^/api/weather/forecast/-?[0-9]{1,2}\\.[0-9],-?[0-9]{1,3}\\.[0-9]$", "query": ["type=hourly&days=1", "days=14"] },
    { "name": "public_readonly_competitions", "path": "^/api/competitions(/(current|[0-9]{4}-W(0[1-9]|[1-4][0-9]|5[0-3])))?$", "query": [""] },
    { "name": "public_notifications_config", "path": "^/api/notifications/config$", "query": [""] },
    { "name": "public_notifications_list", "path": "^/api/notifications/subscriptions/0x[0-9a-fA-F]{40}$", "query": [""], "requiresBearer": true },
    { "name": "public_readonly_forecast_check_summary", "path": "^/api/forecast-verification/summary$", "query": [""] },
    { "name": "public_readonly_forecast_check_record", "path": "^/api/forecast-verification/forecasts/[0-9a-f]{64}$", "query": [""] },
    { "name": "public_readonly_challenge_board", "path": "^/api/challenges/code/[A-Z0-9]{4}-[A-Z0-9]{4}$", "query": [""] },
    { "name": "public_challenges_mine", "path": "^/api/challenges$", "query": [""], "requiresBearer": true }
  ],
  "post": [
    { "name": "public_wallet_send", "path": "^/api/wallet/send$", "query": [""], "requiresBearer": true, "contentType": "application/json", "maxBytes": 4096, "gate": "PUBLIC_READONLY_API=on" },
    { "name": "wolfram_reading_check", "path": "^/api/integrations/wolfram/reading-check$", "query": [""], "requiresBearer": false, "contentType": "application/json", "maxBytes": 2048, "gate": "PUBLIC_READONLY_API=on" },
    { "name": "public_notifications_subscribe", "path": "^/api/notifications/subscriptions$", "query": [""], "requiresBearer": true, "contentType": "application/json", "maxBytes": 4096, "gate": "PUBLIC_READONLY_API=on" },
    { "name": "public_notifications_test", "path": "^/api/notifications/subscriptions/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/test$", "query": [""], "requiresBearer": true, "maxBytes": 1024, "gate": "PUBLIC_READONLY_API=on" },
    { "name": "public_notifications_unsubscribe", "path": "^/api/notifications/unsubscribe$", "query": [""], "contentType": "application/json", "maxBytes": 4096, "gate": "PUBLIC_READONLY_API=on" },
    { "name": "public_forecast_check_submit", "path": "^/api/forecast-verification/forecasts$", "query": [""], "contentType": "application/json", "maxBytes": 8192, "gate": "PUBLIC_READONLY_API=on" },
    { "name": "public_notifications_passkey_challenge", "path": "^/api/notifications/passkey/challenge$", "query": [""], "requiresBearer": false, "contentType": "application/json", "maxBytes": 1024, "gate": "PUBLIC_READONLY_API=on" },
    { "name": "public_notifications_passkey_subscribe", "path": "^/api/notifications/passkey/subscriptions$", "query": [""], "requiresBearer": false, "contentType": "application/json", "maxBytes": 4096, "gate": "PUBLIC_READONLY_API=on" },
    { "name": "public_notifications_passkey_unsubscribe", "path": "^/api/notifications/passkey/unsubscribe$", "query": [""], "requiresBearer": false, "contentType": "application/json", "maxBytes": 4096, "gate": "PUBLIC_READONLY_API=on" },
    { "name": "public_challenges_write", "path": "^/api/challenges(/join|/sync)?$", "query": [""], "requiresBearer": true, "contentType": "application/json", "maxBytes": 4096, "gate": "PUBLIC_READONLY_API=on" }
  ],
  "delete": [
    { "name": "public_notifications_delete", "path": "^/api/notifications/subscriptions/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", "query": [""], "requiresBearer": true, "gate": "PUBLIC_READONLY_API=on" }
  ]
