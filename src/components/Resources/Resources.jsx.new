import React, { useState } from 'react';
import Card from '../common/Card';
import './Resources.css';

import SecurityDocs from './SecurityDocs';

const Resources = () => {
  const [activeTab, setActiveTab] = useState('documentation'); // 'documentation', 'security', 'community'
  
  return (
    <div className="resources">
      <h2 className="dashboard-title mb-4">Resources & Documentation</h2>
      
      <div className="resources-tabs">
        <div 
          className={`resources-tab ${activeTab === 'documentation' ? 'active' : ''}`}
          onClick={() => setActiveTab('documentation')}
        >
          Documentation
        </div>
        <div 
          className={`resources-tab ${activeTab === 'security' ? 'active' : ''}`}
          onClick={() => setActiveTab('security')}
        >
          Security
        </div>
        <div 
          className={`resources-tab ${activeTab === 'community' ? 'active' : ''}`}
          onClick={() => setActiveTab('community')}
        >
          Community Resources
        </div>
      </div>
      
      {activeTab === 'documentation' && (
        <div className="wiki-wrapper">
          <div className="wiki-header">
