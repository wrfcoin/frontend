# WRFCoin frontend environment template.
# Vite only exposes variables prefixed with VITE_ to browser code.
# Values below are same-origin defaults for testnet, local development, and CI
# examples. Keep API paths relative unless you are intentionally building a
# standalone frontend against a specific backend origin.

# Core API endpoints
VITE_API_BASE_URL=/api
VITE_API_URL=/api
VITE_UNIFIED_API_URL=/api
VITE_READER_TOKEN=replace_with_testnet_reader_token
# These values are part of the transaction-signature domain. A wallet send
# refuses to sign if either is absent; never default a testnet build to mainnet.
# Pinned by wrfcoin/infra testnet/cut-pins.env (WRFCOIN_CUT_CHAIN_ID).
VITE_WRFCOIN_CHAIN_ID=777
VITE_WRFCOIN_NETWORK_ID=testnet
# Relying-party origin the ed25519 wallet login challenge must name (its URI:
# and host lines). Required: the web wallet takes it ONLY from this build value
# (no window.location fallback) and refuses to sign a login without it. It must
# equal the backend's WRFCOIN_WALLET_AUTH_ORIGIN (backend dev default
# http://localhost:5000; the testnet image passes the funnel origin via
# wrfcoin/infra testnet/docker-compose.override.yml).
VITE_WALLET_AUTH_ORIGIN=http://localhost:5000

# Domain-specific API endpoints
VITE_WEATHER_API_BASE_URL=/api
VITE_EARNINGS_API_BASE_URL=/api
VITE_GOVERNANCE_API_BASE_URL=/api
VITE_GOVERNANCE_API_URL=/api/governance
VITE_COMPUTE_API_BASE_URL=/api
VITE_COMPUTE_API_URL=/api/compute
VITE_VALIDATOR_API_BASE_URL=/api
VITE_WALLET_API_BASE_URL=/api/wallet
VITE_WALLET_API_URL=/api/wallet
VITE_STORAGE_API_URL=/api/storage
VITE_IOT_API_URL=/api/iot
VITE_CONTRACTS_API_URL=/api/contracts
VITE_CROSSCHAIN_API_URL=/api/crosschain

# WebSocket endpoints
VITE_WS_URL=/ws
VITE_WEBSOCKET_URL=/ws
VITE_MINING_WS_URL=/ws/mining
VITE_IOT_WS_URL=/ws/iot

# Service URLs
VITE_CROSS_CHAIN_URL=/api/cross-chain
VITE_WALLET_URL=/api/wallet

# Feature flags
VITE_MVP_MODE=false
# Fail-closed: omit in public-testnet builds. Only exact `true` exposes bridge,
# DeFi/staking, carbon, and smart-contract routes and navigation.
VITE_ENABLE_CONTRACT_SURFACES=false
# Internal/staging builds ONLY (frontend#348). Exact `true`, together with
# VITE_ENABLE_FULL_STUDIO=true, mounts /wallet, /connect-station, /onboarding,
# /governance and the other operator-preview families under a permanent
# "Internal preview" banner. Must stay empty for the public release build.
VITE_ENABLE_OPERATOR_PREVIEW=
VITE_LEADERBOARD_REGIONS=false

# Third-party public IDs and client IDs
VITE_RAMP_API_KEY=replace_with_ramp_public_key
VITE_GOOGLE_CLIENT_ID=replace_with_google_client_id
VITE_APPLE_CLIENT_ID=replace_with_apple_client_id
VITE_INFURA_PROJECT_ID=replace_with_infura_project_id
VITE_VAPID_PUBLIC_KEY=replace_with_vapid_public_key

# Optional device configuration
VITE_ACURITE_DEVICE_ID=replace_with_acurite_device_id

# Block explorer (optional). Leave empty if no WRFCoin testnet explorer is
# deployed yet — the wallet UI then renders tx hashes/addresses as plain text
# instead of linking to a (wrong) explorer. Do NOT point this at Etherscan.
VITE_EXPLORER_URL=

# Contract addresses
VITE_WEATHER_STREAK_NFT_ADDRESS=0x0000000000000000000000000000000000000000
VITE_STORM_CHASER_NFT_ADDRESS=0x0000000000000000000000000000000000000000

# Map tiles (frontend#297). Default is keyless OpenStreetMap; set both to use a keyed provider.
# VITE_MAP_TILE_URL=https://example.com/{z}/{x}/{y}.png?api_key=...
# VITE_MAP_TILE_ATTRIBUTION=&copy; <a href="https://example.com">Provider</a>
