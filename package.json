{
  "name": "wrfcoin-core-frontend",
  "version": "1.0.0",
  "description": "Frontend for Wrfcoin Core blockchain application",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5000",
    "dev:fast": "node optimize-startup.js && vite --host 127.0.0.1 --port 5000",
    "build": "vite build",
    "build:deps": "vite optimize",
    "preview": "vite preview",
    "optimize": "node optimize-startup.js",
    "storybook": "storybook dev -p 6006",
    "storybook:generate": "node .storybook/generate-stories.js",
    "storybook:dev": "npm run storybook",
    "build-storybook": "storybook build",
    "chromatic": "chromatic",
    "chromatic:ci": "chromatic --exit-zero-on-changes",
    "test:visual": "npm run chromatic:ci",
    "analyze-components": "npx tsx src/tools/routeCLI.ts",
    "analyze-components:help": "npx tsx src/tools/routeCLI.ts --help",
    "analyze-components:auto-fix": "npx tsx src/tools/routeCLI.ts --auto-fix",
    "analyze-components:dry-run": "npx tsx src/tools/routeCLI.ts --auto-fix --dry-run",
    "analyze-components:safe-fix": "npx tsx src/tools/routeCLI.ts --auto-fix --min-risk-score 9",
    "lint:dead-components": "eslint 'src/**/*.{js,jsx,ts,tsx}'",
    "fix:dead-components": "eslint 'src/**/*.{js,jsx,ts,tsx}' --fix",
    "analyze:lifecycle": "node scripts/component-lifecycle-analyzer.cjs",
    "analyze:dead": "node scripts/component-lifecycle-analyzer.cjs --filter dead",
    "analyze:forgotten": "node scripts/component-lifecycle-analyzer.cjs --filter forgotten-ui",
    "analyze:active": "node scripts/component-lifecycle-analyzer.cjs --filter active",
    "analyze:internal": "node scripts/component-lifecycle-analyzer.cjs --filter internal",
    "ci:component-analysis": "npm run analyze-components && npm run lint:dead-components",
    "ci:storybook-build": "npm run build-storybook --quiet",
    "ci:chromatic-fast": "chromatic --exit-zero-on-changes --only-changed",
    "ci:health-check": "npm run analyze-components && node scripts/component-health-check.js",
    "report:design-system": "node scripts/design-system-report.mjs",
    "report:design-system:verbose": "node scripts/design-system-report.mjs --verbose",
    "ci:cleanup-dry-run": "npm run analyze-components:dry-run",
    "ci:cleanup-safe": "npm run analyze-components:safe-fix",
    "performance:storybook": "npm run storybook:generate && node scripts/storybook-performance-check.js",
    "lint": "npm run check:fabrication && eslint src --ext .js,.jsx,.ts,.tsx",
    "check:fabrication": "node scripts/check-ungated-fabrication.mjs",
    "test:fabrication": "node --test scripts/__tests__/check-ungated-fabrication.test.mjs",
    "lint:fix": "eslint src --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write src/**/*.{js,jsx,ts,tsx,json,css,md}",
    "format:check": "prettier --check src/**/*.{js,jsx,ts,tsx,json,css,md}",
    "test:e2e": "playwright test",
    "test:e2e:explorer": "VITE_PUBLIC_READONLY_PATHS=true VITE_ENABLE_FULL_STUDIO=false playwright test src/__tests__/playwright/testnet-explorer-health.spec.js",
    "qa:visual": "node scripts/visual-qa/run.mjs",
    "type-check": "tsc --noEmit",
    "docs:version": "node scripts/create-version.js",
    "docs:version:major": "npm version major && npm run docs:version",
    "docs:version:minor": "npm version minor && npm run docs:version",
    "docs:version:patch": "npm version patch && npm run docs:version",
    "docs:versions:list": "node scripts/documentation-versioning.js list",
    "docs:versions:clean": "node scripts/documentation-versioning.js clean",
    "test:api-client": "NODE_OPTIONS=--experimental-vm-modules jest src/services/apiClient/__tests__ --runInBand",
    "pretest": "node --test scripts/__tests__/*.test.mjs && npm run check:fabrication",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:node": "node --test src/**/__tests__/**/*.mjs src/**/*.test.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/orbitron": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.10",
    "@mui/icons-material": "^7.2.0",
    "@mui/material": "^7.2.0",
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.1",
    "@tanstack/react-query": "^5.90.16",
    "@types/uuid": "^11.0.0",
    "axios": "^1.15.0",
    "bootstrap": "5.3.2",
    "bootstrap-icons": "^1.13.1",
    "chart.js": "^4.4.0",
    "d3": "^7.9.0",
    "dompurify": "3.4.13",
    "ethers": "6.17.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.575.0",
    "marked": "^17.0.2",
    "qrcode": "1.5.4",
    "react": "^19.2.4",
    "react-calendar-heatmap": "^1.10.0",
    "react-chartjs-2": "^5.2.0",
    "react-countup": "^6.5.3",
    "react-dom": "^19.2.4",
    "react-leaflet": "^5.0.0",
    "react-router": "7.18.2",
    "react-router-dom": "7.18.2",
    "react-tooltip": "^5.30.0",
    "recharts": "^3.7.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/environment": "^30.4.1",
    "@jest/fake-timers": "^30.4.1",
    "@playwright/test": "^1.60.0",
    "@storybook/addon-a11y": "^10.2.10",
    "@storybook/addon-docs": "^10.2.10",
    "@storybook/addon-links": "^10.2.10",
    "@storybook/addon-onboarding": "^10.2.10",
    "@storybook/react": "^10.2.10",
    "@storybook/react-vite": "^10.2.10",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/crypto-js": "^4.2.2",
    "@types/d3": "^7.4.3",
    "@types/jest": "^30.0.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^25.0.10",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "@vitejs/plugin-react": "^5.1.3",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.11.1",
    "chromatic": "^15.0.0",
    "eslint": "^10.0.0",
    "eslint-plugin-storybook": "^10.2.10",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.4.1",
    "jest-mock": "^30.4.1",
    "msw": "^2.11.6",
    "postcss": "^8.4.49",
    "storybook": "^10.2.10",
    "tailwindcss": "^3.4.17",
    "terser": "^5.46.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.8.3",
    "vite": "^7.3.2"
  },
  "resolutions": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "glob": "^11.1.0"
  },
  "overrides": {
    "glob": "^11.1.0",
    "esbuild": ">=0.25.0"
  },
  "license": "MIT OR Apache-2.0"
}
